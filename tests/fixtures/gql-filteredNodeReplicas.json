es.la7play.it/video/0/406/0_7dr3gqdd_0_986gwhtw_2/d-alema-l-ex-comunista-e-la-destra-al-potere-puntata-del-28/cover-600x800.webp","variations":[{"style":"cover_sm","url":"https://images.la7play.it/video/0/406/0_7dr3gqdd_0_986gwhtw_2/d-alema-l-ex-comunista-e-la-destra-al-potere-puntata-del-28/cover-400x533.webp","width":400,"height":533},{"style":"cover_xs","url":"https://images.la7play.it/video/0/406/0_7dr3gqdd_0_986gwhtw_2/d-alema-l-ex-comunista-e-la-destra-al-potere-puntata-del-28/cover-200x267.webp","width":200,"height":267}]}}},{"__typename":"NodeReplica","id":"397980","title":"Del Vecchio vuole comprare Travaglio - Puntata del 27/10/2026","tags":null,"path":"/otto-e-mezzo/puntate/puntata-del-27-10-2026-397980","property":{"id":"549","name":"Otto e mezzo","titolo":"Otto e mezzo","description":{"value":"<p>Otto e mezzo</p>","plainValue":"Otto e mezzo"}},"created":{"timestamp":1793134429,"time":"2026-10-27T20:53:49+00:00"},"sinossibreve":"Confronto sull'interesse di Leonardo Maria Del Vecchio per il Fatto Quotidiano e sul rapporto tra editoria, finanza e informazione. Con Lilli Gruber, Marco Travaglio, Lina Palmerini e Italo Bocchino","body":{"value":"<p>A Otto e Mezzo si discute del possibile ingresso di Leonardo Maria Del Vecchio nell'azionariato del Fatto Quotidiano, un'ipotesi che ha riacceso il dibattito sul rapporto tra editoria, finanza e indipendenza dell'informazione. Nel suo intervento, Marco Travaglio mette in evidenza quella che considera una contraddizione: l'interesse dell'imprenditore per il quotidiano arriva dopo anni di dure critiche rivolte al giornale e ai suoi giornalisti. Da qui il confronto sulle ragioni industriali e strategiche dell'operazione e sui possibili conflitti di interesse che potrebbero emergere nel panorama editoriale italiano. Il dibattito si concentra anche sul ruolo dei grandi gruppi economici nell'informazione, sull'autonomia delle testate giornalistiche e sui cambiamenti che stanno interessando il settore dei media.</p>","summary":""},"intro":null,"smartTvLocandina":null,"dataMessaInOnda":{"timestamp":1793129949,"time":"2026-10-27T19:39:09+00:00"},"urlVideo":null,"uploadVideo":{"cf_duration":"1812","cf_entry_id":"0_a30hvn47","cf_thumbnail_url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_estlljl8_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-854x480.webp","thumbnailDefault":{"url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_estlljl8_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-854x480.webp","variations":[{"style":"scena_lg","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_estlljl8_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-1280x720.webp","width":1280,"height":720},{"style":"scena_sm","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_estlljl8_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-640x360.webp","width":640,"height":360}]},"cf_thumbnail_scena":{"url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_qkupk4x3_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-854x480.webp","variations":[{"style":"scena_lg","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_qkupk4x3_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-1280x720.webp","width":1280,"height":720},{"style":"scena_sm","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_qkupk4x3_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/scena-640x360.webp","width":640,"height":360}]},"cf_thumbnail_cover":{"url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_yietrxo5_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/cover-600x800.webp","variations":[{"style":"cover_sm","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_yietrxo5_2/del-vecchio-vuole-comprare-travaglio-puntata-del-27-10-2026/cover-400x533.webp","width":400,"height":533},{"style":"cover_xs","url":"https://images.la7play.it/video/0/406/0_a30hvn47_0_yietrxo5_2/del-vecc